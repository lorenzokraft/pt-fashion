{{ 'pt-simple-hero.css' | asset_url | stylesheet_tag }}

<style>
  #pt-simple-hero-{{ section.id }} {
    height: {{ section.settings.hero_height }}vh;
    min-height: {{ section.settings.hero_height }}vh;
  }
  
  #pt-simple-hero-{{ section.id }} .pt-hero-img {
    transform: scale({{ section.settings.image_scale | divided_by: 100.0 }});
  }
  
  #pt-simple-hero-{{ section.id }} .pt-collection-name {
    font-family: '{{ section.settings.collection_font }}', sans-serif;
    font-size: {{ section.settings.collection_font_size }}px;
    font-weight: {{ section.settings.collection_font_weight }};
  }
  
  #pt-simple-hero-{{ section.id }} .pt-hero-tagline {
    font-family: '{{ section.settings.tagline_font }}', sans-serif;
    font-size: {{ section.settings.tagline_font_size }}px;
    font-weight: {{ section.settings.tagline_font_weight }};
  }
  
  @media (max-width: 768px) {
    #pt-simple-hero-{{ section.id }} .pt-collection-name {
      font-size: {{ section.settings.collection_font_size_mobile }}px;
    }
    
    #pt-simple-hero-{{ section.id }} .pt-hero-tagline {
      font-size: {{ section.settings.tagline_font_size_mobile }}px;
    }
  }
</style>

<section class="pt-simple-hero" id="pt-simple-hero-{{ section.id }}">
  <div class="pt-hero-background-image">
    {% if section.settings.hero_image %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'pt-hero-img' }}
    {% else %}
      <div class="pt-hero-placeholder">Hero Image</div>
    {% endif %}
  </div>
  
  <div class="pt-hero-overlay"></div>
  
  <div class="pt-hero-content">
    {% if section.settings.collection_name != blank %}
      <h1 class="pt-collection-name">{{ section.settings.collection_name }}</h1>
    {% endif %}
    
    {% if section.settings.tagline != blank %}
      <p class="pt-hero-tagline">{{ section.settings.tagline }}</p>
    {% endif %}
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" class="pt-hero-button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
  
  <!-- Scroll Down Indicator -->
  <div class="pt-scroll-indicator" onclick="scrollToProducts()">
    <div class="pt-scroll-circle">
      <svg class="pt-scroll-text" viewBox="0 0 200 200">
        <defs>
          <path id="circlePath" d="M 100, 100 m -75, 0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0"/>
        </defs>
        <text class="pt-circle-text">
          <textPath href="#circlePath" startOffset="0%">
            Scroll Down • Scroll Down • Scroll Down •
          </textPath>
        </text>
      </svg>
      <div class="pt-scroll-arrow">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  function scrollToProducts() {
    const productSection = document.querySelector('.pt-product-showcase');
    if (productSection) {
      productSection.scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
      });
    }
  }
</script>

