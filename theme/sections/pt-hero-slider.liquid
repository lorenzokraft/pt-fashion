{{ 'pt-hero-slider.css' | asset_url | stylesheet_tag }}

<div class="pt-hero-slider" data-section-id="{{ section.id }}">
  <div class="pt-hero-container">
    
    <!-- Decorative Background Elements -->
    <div class="pt-hero-decorations">
      <!-- Hero Glow Effect -->
      <div class="hero-glow"></div>
      
      <!-- Circular Arcs (Top Left) -->
      <svg class="pt-deco-arcs" viewBox="0 0 300 300">
        <circle cx="0" cy="0" r="80" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
        <circle cx="0" cy="0" r="120" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
        <circle cx="0" cy="0" r="160" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5"/>
      </svg>
      
      <!-- Dot Pattern Grid (Left Side) -->
      <div class="pt-deco-dots"></div>
      
      <!-- Large Green Blob Shape -->
      <svg class="pt-deco-blob" viewBox="0 0 800 800">
        <path d="M400,100 Q600,150 650,350 T500,650 Q300,650 150,500 T400,100 Z" 
              fill="rgba(139, 195, 74, 0.35)" />
      </svg>
      
      <!-- Large PT Watermark -->
      <div class="pt-deco-watermark">PT</div>
      
      <!-- Circular Premium Quality Badge -->
      <div class="pt-deco-badge">
        <svg viewBox="0 0 200 200">
          <circle cx="100" cy="100" r="95" fill="rgba(255,255,255,0.9)" stroke="rgba(107,142,35,0.3)" stroke-width="2"/>
          <text x="100" y="70" text-anchor="middle" font-size="12" font-weight="700" fill="#1a1a1a" letter-spacing="2">PREMIUM QUALITY</text>
          <text x="100" y="110" text-anchor="middle" font-size="48" font-weight="900" fill="#1a1a1a">P</text>
          <text x="100" y="135" text-anchor="middle" font-size="12" font-weight="700" fill="#1a1a1a" letter-spacing="2">TIMELESS STYLE</text>
          <text x="60" y="105" font-size="16" fill="#1a1a1a">★</text>
          <text x="135" y="105" font-size="16" fill="#1a1a1a">★</text>
        </svg>
      </div>
      
      <!-- Curved Arrow (Bottom) -->
      <svg class="pt-deco-arrow" viewBox="0 0 200 100">
        <path d="M 20,80 Q 100,20 180,80" fill="none" stroke="rgba(107,142,35,0.4)" stroke-width="2.5" marker-end="url(#arrowhead)"/>
        <defs>
          <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="5" refY="3" orient="auto">
            <polygon points="0 0, 10 3, 0 6" fill="rgba(107,142,35,0.4)"/>
          </marker>
        </defs>
      </svg>
    </div>
    
    <div class="pt-hero-background">
      <div class="pt-hero-brand">
        <h1 class="pt-brand-text">
          <span class="pt-text">PT</span>
        </h1>
        <p class="pt-brand-subtitle">CLOTHING</p>
      </div>
    </div>

    <div class="pt-hero-slides">
      {% for block in section.blocks %}
        <div class="pt-slide {% if forloop.first %}active{% endif %}" 
             data-slide="{{ forloop.index0 }}"
             data-color="{{ block.settings.background_color }}"
             {{ block.shopify_attributes }}>
          
          <div class="pt-slide-content">
            <div class="pt-product-info">
              {% if block.settings.show_badge %}
              <div class="pt-badge">
                <span class="pt-badge-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z" fill="#6B8E23"/>
                    <path d="M19 4L19.5 6.5L22 7L19.5 7.5L19 10L18.5 7.5L16 7L18.5 6.5L19 4Z" fill="#6B8E23"/>
                    <path d="M7 15L7.3 16.5L9 17L7.3 17.5L7 19L6.7 17.5L5 17L6.7 16.5L7 15Z" fill="#6B8E23"/>
                  </svg>
                </span>
                <span class="pt-badge-text">{{ block.settings.badge_text }}</span>
              </div>
              {% endif %}
              
              <h2 class="pt-product-name">
                {{ block.settings.product_name }}
                {% if block.settings.product_subtitle != blank %}
                <span class="pt-product-subtitle">– {{ block.settings.product_subtitle }}</span>
                {% endif %}
              </h2>
              
              {% if block.settings.tagline != blank %}
              <div class="pt-tagline">
                <p class="pt-tagline-main">{{ block.settings.tagline }}</p>
                {% if block.settings.tagline_sub != blank %}
                <p class="pt-tagline-sub">{{ block.settings.tagline_sub }}</p>
                {% endif %}
              </div>
              {% endif %}

              {% if block.settings.show_size_selector %}
              <div class="pt-size-selector">
                <p class="pt-label">SELECT SIZE (US)</p>
                <div class="pt-size-grid">
                  {% assign sizes = "8,8.5,9,9.5,10,10.5,11,11.5,12,12.5" | split: "," %}
                  {% for size in sizes %}
                    <button class="pt-size-btn">{{ size }}</button>
                  {% endfor %}
                </div>
              </div>
              {% endif %}

              {% if block.settings.show_color_selector %}
              <div class="pt-color-selector">
                <p class="pt-label">SELECT COLOR</p>
                <div class="pt-color-options">
                  <button class="pt-color-btn" style="background-color: #E63946;"></button>
                  <button class="pt-color-btn" style="background-color: #1D3557;"></button>
                  <button class="pt-color-btn" style="background-color: #457B9D;"></button>
                </div>
              </div>
              {% endif %}
              
              {% if block.settings.show_cta_buttons %}
              <div class="pt-cta-buttons">
                <button class="pt-btn pt-btn-primary">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                  ADD TO BAG
                </button>
                <button class="pt-btn pt-btn-secondary">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                  VIEW DETAILS
                </button>
              </div>
              {% endif %}
            </div>

            <div class="pt-product-image">
              {%- comment -%} Desktop Image {%- endcomment -%}
              {% if block.settings.image != blank %}
                <img class="pt-desktop-image" 
                     src="{{ block.settings.image | image_url: width: 800 }}" 
                     alt="{{ block.settings.product_name }}"
                     loading="lazy">
              {% elsif block.settings.image_asset != blank %}
                <img class="pt-desktop-image" 
                     src="{{ block.settings.image_asset | asset_url }}" 
                     alt="{{ block.settings.product_name }}"
                     loading="lazy">
              {% endif %}
              
              {%- comment -%} Mobile Image (if provided) {%- endcomment -%}
              {% if block.settings.mobile_image != blank %}
                <img class="pt-mobile-image" 
                     src="{{ block.settings.mobile_image | image_url: width: 600 }}" 
                     alt="{{ block.settings.product_name }}"
                     loading="lazy">
              {% elsif block.settings.mobile_image_asset != blank %}
                <img class="pt-mobile-image" 
                     src="{{ block.settings.mobile_image_asset | asset_url }}" 
                     alt="{{ block.settings.product_name }}"
                     loading="lazy">
              {% endif %}
            </div>

            {% if block.settings.show_testimonial %}
            <div class="pt-testimonial">
              <p>{{ block.settings.testimonial_text }}</p>
            </div>
            {% endif %}
          </div>
          
          <div class="pt-navigation">
            <button class="pt-nav-btn pt-prev" aria-label="Previous slide">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="pt-nav-btn pt-next" aria-label="Next slide">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          
          <div class="pt-mobile-cta">
            <a href="/collections/all" class="pt-mobile-shop-btn">SHOP NOW</a>
          </div>
          
          {% if block.settings.show_features %}
          <div class="pt-features">
            <div class="pt-feature-item">
              <div class="pt-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                  <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
              </div>
              <div class="pt-feature-text">
                <p class="pt-feature-title">ULTRA SOFT FABRIC</p>
                <p class="pt-feature-desc">All-day comfort</p>
              </div>
            </div>
            <div class="pt-feature-item">
              <div class="pt-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div class="pt-feature-text">
                <p class="pt-feature-title">MODERN FIT</p>
                <p class="pt-feature-desc">Designed to move with you</p>
              </div>
            </div>
            <div class="pt-feature-item">
              <div class="pt-feature-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="pt-feature-text">
                <p class="pt-feature-title">PREMIUM QUALITY</p>
                <p class="pt-feature-desc">Made to last, season after season</p>
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</div>

<script>
  class PTHeroSlider {
    constructor(container) {
      this.container = container;
      this.slides = container.querySelectorAll('.pt-slide');
      this.currentSlide = 0;
      this.prevBtn = container.querySelector('.pt-prev');
      this.nextBtn = container.querySelector('.pt-next');
      this.background = container.querySelector('.pt-hero-background');
      
      this.init();
    }

    init() {
      console.log('PT Hero Slider initialized with', this.slides.length, 'slides');
      
      if (this.prevBtn && this.nextBtn) {
        this.prevBtn.addEventListener('click', () => this.navigate(-1));
        this.nextBtn.addEventListener('click', () => this.navigate(1));
      }
      
      this.updateBackground();
    }

    navigate(direction) {
      console.log('=== NAVIGATION START ===');
      console.log('Direction:', direction > 0 ? 'NEXT' : 'PREV');
      console.log('Current slide BEFORE:', this.currentSlide);
      console.log('Total slides:', this.slides.length);
      
      // Calculate new slide index
      const oldIndex = this.currentSlide;
      const calculation = this.currentSlide + direction;
      console.log('Calculation:', this.currentSlide, '+', direction, '=', calculation);
      
      this.currentSlide = (calculation + this.slides.length) % this.slides.length;
      
      console.log('New slide AFTER modulo:', this.currentSlide);
      console.log('Moving from slide', oldIndex, 'to slide', this.currentSlide);
      
      // IMPORTANT: Remove active class from ALL slides first
      this.slides.forEach((slide) => {
        slide.classList.remove('active', 'slide-in-right', 'slide-in-left', 'slide-out-left', 'slide-out-right');
        slide.style.opacity = '0';
        slide.style.pointerEvents = 'none';
      });
      
      // Get the new slide
      const newSlide = this.slides[this.currentSlide];
      
      // Activate new slide
      newSlide.classList.add('active');
      newSlide.style.opacity = '1';
      newSlide.style.pointerEvents = 'auto';
      
      console.log('Activated slide:', this.currentSlide);
      
      // Update background
      this.updateBackground();
    }

    updateBackground() {
      const currentSlideEl = this.slides[this.currentSlide];
      const color = currentSlideEl.dataset.color || '#E63946';
      this.background.style.backgroundColor = color;
      
      const applyColor = (element) => {
        if (element) {
          element.style.backgroundColor = color;
          element.style.transition = 'background-color 0.8s cubic-bezier(0.4, 0, 0.2, 1)';
        }
      };
      
      const headerGroupWrapper = document.querySelector('#header-group');
      const allHeaderSections = document.querySelectorAll('.shopify-section-group-header-group, .shopify-section-group-header-group > *, .header-section, header-component, .header, .header__row, .announcement-bar');
      
      applyColor(headerGroupWrapper);
      allHeaderSections.forEach(el => applyColor(el));
      
      document.body.style.setProperty('--hero-bg-color', color);
      document.body.style.backgroundColor = color;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const sliders = document.querySelectorAll('.pt-hero-slider');
    sliders.forEach(slider => new PTHeroSlider(slider));
  });
</script>

{% schema %}
{
  "name": "PT Hero Slider",
  "tag": "section",
  "class": "pt-hero-section",
  "settings": [
    {
      "type": "range",
      "id": "section_height",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Section Height",
      "default": 700
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Product Slide",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show Badge",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "NEW ARRIVAL"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "PT TRACKSUIT"
        },
        {
          "type": "text",
          "id": "product_subtitle",
          "label": "Product Subtitle",
          "default": "WOMEN"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "Built different. Worn daily."
        },
        {
          "type": "text",
          "id": "tagline_sub",
          "label": "Tagline Subtitle",
          "default": "Premium comfort meets modern style."
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#E63946"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Product Image Asset (e.g., model-men.png)",
          "info": "Use this if the image is in the assets folder"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Product Image",
          "info": "Optional: Use a different image for mobile devices"
        },
        {
          "type": "text",
          "id": "mobile_image_asset",
          "label": "Mobile Image Asset (e.g., model-men-mobile.png)",
          "info": "Optional: Use this if the mobile image is in the assets folder"
        },
        {
          "type": "checkbox",
          "id": "show_size_selector",
          "label": "Show Size Selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_color_selector",
          "label": "Show Color Selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_cta_buttons",
          "label": "Show CTA Buttons",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_features",
          "label": "Show Feature Badges",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_testimonial",
          "label": "Show Testimonial",
          "default": false
        },
        {
          "type": "textarea",
          "id": "testimonial_text",
          "label": "Testimonial Text",
          "default": "The quality is excellent, packed reliably, and the color is a dream. UPS store is excellent. Thank you. We strive to earn and keep your trust."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PT Hero Slider",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "product_name": "JORDAN 1 RED",
            "background_color": "#E63946"
          }
        },
        {
          "type": "slide",
          "settings": {
            "product_name": "JORDAN 1 BLUE",
            "background_color": "#1D3557"
          }
        }
      ]
    }
  ]
}
{% endschema %}
