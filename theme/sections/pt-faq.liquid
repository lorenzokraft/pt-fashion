{{ 'pt-faq.css' | asset_url | stylesheet_tag }}

<section
  class="pt-faq"
  style="
    --faq-bg: {{ section.settings.background_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-border: {{ section.settings.divider_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="pt-faq__container">
    {% if section.settings.heading != blank %}
      <h2 class="pt-faq__heading" style="font-size: {{ section.settings.heading_font_size }}px;">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="pt-faq__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="pt-faq__list">
      {% for block in section.blocks %}
        <div class="pt-faq__item" {{ block.shopify_attributes }}>
          <button
            class="pt-faq__question"
            type="button"
            aria-expanded="false"
            id="pt-faq-q-{{ block.id }}"
            aria-controls="pt-faq-a-{{ block.id }}"
          >
            <span class="pt-faq__question-text">{{ block.settings.question }}</span>
            <span class="pt-faq__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 1V15M1 8H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </span>
          </button>
          <div
            class="pt-faq__answer"
            id="pt-faq-a-{{ block.id }}"
            role="region"
            aria-labelledby="pt-faq-q-{{ block.id }}"
          >
            <div class="pt-faq__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function () {
    var faqSection = document.querySelector('#shopify-section-{{ section.id }} .pt-faq');
    if (!faqSection) return;

    var items = faqSection.querySelectorAll('.pt-faq__item');
    var allowMultiple = {{ section.settings.allow_multiple_open | default: false | json }};

    items.forEach(function (item) {
      var question = item.querySelector('.pt-faq__question');
      var answer = item.querySelector('.pt-faq__answer');
      if (!question || !answer) return;

      question.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');

        if (!allowMultiple) {
          items.forEach(function (other) {
            if (other !== item && other.classList.contains('is-open')) {
              other.classList.remove('is-open');
              var oq = other.querySelector('.pt-faq__question');
              var oa = other.querySelector('.pt-faq__answer');
              if (oq) oq.setAttribute('aria-expanded', 'false');
              if (oa) oa.style.maxHeight = '0px';
            }
          });
        }

        if (isOpen) {
          item.classList.remove('is-open');
          question.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = '0px';
        } else {
          item.classList.add('is-open');
          question.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });

    window.addEventListener('resize', function () {
      faqSection.querySelectorAll('.pt-faq__item.is-open .pt-faq__answer').forEach(function (answer) {
        answer.style.maxHeight = answer.scrollHeight + 'px';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "PT FAQ",
  "tag": "section",
  "class": "pt-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 40
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our products and services."
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple open at once",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (icon)",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#e3ddd4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-day return policy on all unworn items with original tags attached. Simply contact our support team to start a return.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PT FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What sizes do you offer?",
            "answer": "<p>Our tracksuits are available in sizes XS through XXL. Check the size guide on each product page for detailed measurements.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping takes 3-5 business days. Express options are available at checkout for faster delivery.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return policy on all unworn items with original tags attached.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship worldwide. International shipping rates and times are calculated at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
