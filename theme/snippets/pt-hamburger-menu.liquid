{%- doc -%}
  Renders a custom hamburger menu with a smooth slide-out drawer.

  @param {object} menu - The linklist to render
  @param {object} settings - The section settings
{%- enddoc -%}

{{ 'pt-hamburger-menu.css' | asset_url | stylesheet_tag }}

<div class="pt-hamburger" id="pt-hamburger" style="--mobile-padding-top: {{ settings.hamburger_mobile_padding_top | default: 14 }}px;">
  {%- comment -%} Hamburger Toggle Button {%- endcomment -%}
  <button class="pt-hamburger__toggle" id="pt-hamburger-toggle" aria-label="Open menu" aria-expanded="false">
    <span class="pt-hamburger__line pt-hamburger__line--top"></span>
    <span class="pt-hamburger__line pt-hamburger__line--bottom"></span>
  </button>

  {%- comment -%} Overlay {%- endcomment -%}
  <div class="pt-hamburger__overlay" id="pt-hamburger-overlay"></div>

  {%- comment -%} Drawer {%- endcomment -%}
  <nav class="pt-hamburger__drawer" id="pt-hamburger-drawer" aria-label="Main navigation">
    <div class="pt-hamburger__drawer-header">
      <button class="pt-hamburger__close" id="pt-hamburger-close" aria-label="Close menu">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>Close</span>
      </button>
    </div>

    <ul class="pt-hamburger__menu" role="list">
      {%- for link in menu.links -%}
        <li class="pt-hamburger__item" style="--item-index: {{ forloop.index }};">
          {%- if link.links != blank -%}
            <button class="pt-hamburger__link pt-hamburger__link--parent" aria-expanded="false">
              <span>{{ link.title }}</span>
              <svg class="pt-hamburger__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none">
                <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="pt-hamburger__submenu">
              <ul class="pt-hamburger__submenu-list" role="list">
                {%- for child_link in link.links -%}
                  <li class="pt-hamburger__subitem">
                    <a href="{{ child_link.url }}" class="pt-hamburger__sublink">{{ child_link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" class="pt-hamburger__link">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<script>
  (function () {
    var hamburger = document.getElementById('pt-hamburger');
    var toggle = document.getElementById('pt-hamburger-toggle');
    var closeBtn = document.getElementById('pt-hamburger-close');
    var overlay = document.getElementById('pt-hamburger-overlay');
    var drawer = document.getElementById('pt-hamburger-drawer');

    if (!hamburger || !toggle || !drawer) return;

    function openMenu() {
      hamburger.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      hamburger.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';

      // Close all open submenus after drawer closes
      setTimeout(function () {
        drawer.querySelectorAll('.pt-hamburger__item.is-expanded').forEach(function (item) {
          item.classList.remove('is-expanded');
          var btn = item.querySelector('.pt-hamburger__link--parent');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        });
      }, 500);
    }

    toggle.addEventListener('click', function () {
      if (hamburger.classList.contains('is-open')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);

    document.addEventListener('keyup', function (e) {
      if (e.key === 'Escape' && hamburger.classList.contains('is-open')) {
        closeMenu();
      }
    });

    // Accordion submenus with smooth height animation
    drawer.querySelectorAll('.pt-hamburger__link--parent').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.pt-hamburger__item');
        var submenu = item.querySelector('.pt-hamburger__submenu');
        var isExpanded = item.classList.contains('is-expanded');

        if (isExpanded) {
          submenu.style.maxHeight = submenu.scrollHeight + 'px';
          requestAnimationFrame(function () {
            submenu.style.maxHeight = '0px';
          });
          item.classList.remove('is-expanded');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          // Close other open submenus
          drawer.querySelectorAll('.pt-hamburger__item.is-expanded').forEach(function (other) {
            if (other !== item) {
              var otherSubmenu = other.querySelector('.pt-hamburger__submenu');
              var otherBtn = other.querySelector('.pt-hamburger__link--parent');
              otherSubmenu.style.maxHeight = '0px';
              other.classList.remove('is-expanded');
              if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            }
          });

          submenu.style.maxHeight = submenu.scrollHeight + 'px';
          item.classList.add('is-expanded');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>
